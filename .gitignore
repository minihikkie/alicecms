# ═══════════════════════════════════════════════════════════════
#  ความลับ — ห้ามขึ้น repo เด็ดขาด
#  ถ้าหลุดขึ้นไปแล้วแม้จะลบทีหลัง ก็ยังอยู่ในประวัติ git ถาวร
# ═══════════════════════════════════════════════════════════════

# กุญแจลับสำหรับเซ็นแพ็กเกจอัปเดต — อันตรายที่สุดในโปรเจกต์นี้
# ใครได้ไฟล์นี้ไป จะปลอมแพ็กเกจอัปเดตให้ทุกเว็บที่ติดตั้งระบบนี้ยอมรับได้ทันที
/tools/release-key/
*.pem
*.key
*.p12
*.pfx

# ค่าเชื่อมต่อฐานข้อมูลของเครื่องจริง
/config.php
/install.lock
.env
.env.*

# ═══════════════════════════════════════════════════════════════
#  ข้อมูลจริงของผู้ใช้งาน — ไม่ใช่ความลับของโค้ด แต่เป็นข้อมูลส่วนบุคคล
# ═══════════════════════════════════════════════════════════════

# ไฟล์ที่ผู้ใช้อัปโหลด (รูป เอกสาร ไฟล์แนบเรื่องร้องเรียน)
# เก็บเฉพาะ .htaccess เพราะเป็นส่วนหนึ่งของระบบความปลอดภัย
/uploads/**
!/uploads/**/
!/uploads/.htaccess
!/uploads/**/.htaccess

# ไฟล์ทำงานของระบบ: สำรองฐานข้อมูล ชุดสำรองก่อนอัปเดต ถังขยะ เซสชัน
# ไฟล์ .sql ในนี้มีรหัสผ่านผู้ดูแลและข้อมูลผู้ร้องเรียน
/storage/**
!/storage/**/
!/storage/.gitkeep
!/storage/.htaccess
!/storage/**/.htaccess
/backups/**
!/backups/.htaccess

# ═══════════════════════════════════════════════════════════════
#  ไฟล์ที่สร้างขึ้นใหม่ได้ ไม่ต้องเก็บใน repo
# ═══════════════════════════════════════════════════════════════

# แพ็กเกจ release ที่ build แล้ว (สร้างใหม่ได้ด้วย tools/build-release.php)
/dist/

# เครื่องมือวินิจฉัยเฉพาะกิจ — ไม่ควรอยู่บนเซิร์ฟเวอร์จริง
/check-server.php
/upload-test.php
/session-check.php

# ตั้งค่าเครื่องมือ/บรรณาธิการส่วนตัว
/.claude/
.vscode/
.idea/
*.code-workspace

# ขยะของระบบปฏิบัติการ
.DS_Store
Thumbs.db
desktop.ini

# ไฟล์ชั่วคราว
*.log
*.bak
*.old
*.tmp
*~
node_modules/
